  "server_side_environment_variables": [
    "BUDLY_RUNTIME_ENV", "BUDLY_RUNTIME_HOST", "BUDLY_RUNTIME_PORT",
    "BUDLY_RUNTIME_SHARED_SECRET", "BUDLY_MODEL_PROVIDER", "BUDLY_MODEL_NAME",
    "BUDLY_MODEL_API_KEY", "BUDLY_MODEL_TIMEOUT_SECONDS", "BUDLY_MODEL_RETRY_COUNT",
